.sec-head { margin-bottom: clamp(40px, 6vw, 72px); }

.sec-kicker { display: flex; align-items: center; gap: 16px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin: 0px 0px 22px; }

.sec-kicker .sec-num { color: var(--accent); }


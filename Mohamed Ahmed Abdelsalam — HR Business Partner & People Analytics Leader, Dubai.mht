.impact .sec-kicker .sec-num { color: var(--accent-light); }

.impact .sec-title { color: var(--dark-bright); }

.impact .sec-lede { color: var(--dark-muted); }

.lead { display: grid; grid-template-columns: minmax(0px, 1.05fr) minmax(0px, 0.95fr); gap: clamp(20px, 4vw, 64px); align-items: end; padding-bottom: clamp(34px, 5vw, 56px); border-bottom: 1px solid var(--dark-line); }

.lead-num { font-family: var(--font-display); font-weight: 400; font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 0; font-size: clamp(3.4rem, 9.5vw, 7.2rem); line-height: 0.85; letter-spacing: -0.045em; color: var(--dark-bright); }


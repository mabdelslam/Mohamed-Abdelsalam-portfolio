@charset "utf-8";

:root { --paper: #FAF7F2; --paper-2: #F2ECE2; --paper-3: #E9E1D4; --ink: #17140F; --ink-soft: #3D372D; --muted: #7C7365; --line: #DFD6C7; --accent: #C4522A; --accent-light: #E2703F; --dark: #141210; --dark-2: #1D1A16; --dark-line: #332E27; --dark-muted: #9A9184; --dark-text: #CFC7BA; --dark-bright: #F5F0E8; --maxw: 1240px; --pad: clamp(20px,5vw,64px); --font-display: 'Fraunces',Georgia,'Times New Roman',serif; --font-body: 'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; --font-mono: 'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; --ease: cubic-bezier(.22,.8,.24,1); }

*, ::before, ::after { box-sizing: border-box; }

html { text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 88px; }

body { margin: 0px; background: var(--paper); color: var(--ink-soft); font-family: var(--font-body); font-size: 16px; font-weight: 400; line-height: 1.62; -webkit-font-smoothing: antialiased; overflow-x: hidden; }

